{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E9",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "app.everytool.ios",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "app.everytool.ios.share",
                  "targetName": "EverytoolShare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.everytool.ios"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.everytool.ios.keyboard",
                  "targetName": "EverytoolKeyboard",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.everytool.ios"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.everytool.ios.widget",
                  "targetName": "EverytoolControls",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.everytool.ios"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.everytool.ios.broadcastui",
                  "targetName": "EverytoolBroadcastUI"
                },
                {
                  "bundleIdentifier": "app.everytool.ios.broadcast",
                  "targetName": "EverytoolBroadcast",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.everytool.ios"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "74d5cac4-d621-4281-af33-4305f1a3eba8"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "appleTeamId": "8H56KM6SCW",
      "bundleIdentifier": "app.everytool.ios",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.everytool.ios"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Everytool uses the camera to scan QR codes and receipts. Everything is read on this phone.",
        "NSMicrophoneUsageDescription": "Everytool never records audio. This is only requested if you start a screen recording that includes sound.",
        "NSPhotoLibraryAddUsageDescription": "Everytool saves finished screenshots, images and GIFs to your photo library.",
        "NSPhotoLibraryUsageDescription": "Everytool reads the photos you pick \u2014 and, in a screenshot session, the screenshots you take \u2014 so it can stitch, convert, resize, scan and make GIFs, all on this phone.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "name": "Everytool",
    "orientation": "portrait",
    "owner": "checkpoint2022s-team",
    "plugins": [
      "expo-status-bar",
      "@bacons/apple-targets",
      "expo-image-picker",
      "expo-camera",
      "expo-media-library",
      "@react-native-community/datetimepicker",
      "./plugins/withOpenToolIntent.js"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": "everytool",
    "slug": "everytool",
    "updates": {
      "url": "https://u.expo.dev/74d5cac4-d621-4281-af33-4305f1a3eba8"
    },
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
