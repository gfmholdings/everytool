      "expo-camera",
      "expo-media-library",
      "@react-native-community/datetimepicker"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": "everytool",
    "slug": "everytool",
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_EVERYTOOL_EAS_PROJECT_ID"
    },
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
