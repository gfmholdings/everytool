{
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "credentialsSource": "local"
    }
  },
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 5.0.0"
  },
  "submit": {
    "production": {}
  }
}